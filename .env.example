# Plus500US T4 API SDK – Environment Configuration
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to version control.

# Environment: "sim" (simulator/paper – default) or "live"
PLUS500_T4_ENV=sim

# Authentication – choose ONE method:
# Option A: API Key
PLUS500_T4_API_KEY=

# Option B: Username/Password
PLUS500_T4_FIRM=
PLUS500_T4_USERNAME=
PLUS500_T4_PASSWORD=
PLUS500_T4_APP_NAME=
PLUS500_T4_APP_LICENSE=

# Account / market defaults
PLUS500_T4_ACCOUNT_ID=
PLUS500_T4_DEFAULT_MARKET_ID=

# Safety controls
PLUS500_T4_LIVE_TRADING_ENABLED=false    # must be "true" to send live orders
PLUS500_T4_DRY_RUN=false                 # set "true" to build messages without sending

# Logging: DEBUG | INFO | WARNING | ERROR
PLUS500_T4_LOG_LEVEL=INFO
